{
    "name": "lrs/data-analyst",
    "description": "LRS Learning Analyst",
    "type": "project",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "php-di/php-di": "^6.3",
        "simplesamlphp/simplesamlphp": "2.3",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LRSDA\\": "src/"
        }
    },
    "scripts": {},
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true
        }
    }
}
