            }
        },
        {
            "name": "ULLAMobileAppFeed",
            "description": "Un objet dédié aux interactions avec le feed de l'app mobile ULLA",
            "type": "http://smart.uliege.be/ulla/mobileapp/feed/1.0",
            "ifi_root": "http://smart.uliege.be/ulla/mobileapp/feed/1.0",
