    "verbs": [
        {
            "name": "completed",
            "id": "http://activitystrea.ms/schema/1.0/complete",
            "display": {
                "fr-FR": "a terminé"
            },
            "description": "l'acteur a terminé l'objet (Test,Survey) associé. Eventuellement un élément 'Result' est associé au statement "
        },
        {
            "name": "received",
            "id": "http://activitystrea.ms/schema/1.0/receive",
            "display": {
                "fr-FR": "a reçu"
            },
            "description": "l'acteur a reçu un élément (Survey, Feeback, Message, ...) associé."
        },
        {
            "name": "accessed",
            "id": "http://activitystrea.ms/schema/1.0/access",
            "display": {
                "fr-FR": "a accedé"
            },
            "description": "l'Acteur a accédé à un l'élément associé (un Resultat, un Feedback, un Survey), il l'a 'visualisé' et n'a rien fait d'autre"
        },
        {
            "name": "acknowledge",
            "id": "http://activitystrea.ms/schema/1.0/acknowledge",
            "display": {
                "fr-FR": "a pris connaissance"
            },
            "description": "L'acteur s'est vu présenté l'objet associé."
        },
        {
            "name": "answered",
            "id": "http://adlnet.gov/expapi/verbs/answered",
            "display": {
                "fr-FR": "a répondu"
            },
            "description": "L'acteur à répondu à la question référencée par l'object associé. Le statement devra donc contenir un élément 'Result'."
        },
        {
            "name": "enrolled",
            "id": "http://www.uliege.be/smart/xAPITerms/verbs/enrolled",
            "display": {
                "fr-FR": "est inscrit"
            },
            "description": "L'utilisateur a accepté les condition d'utilisation du service."
        },
        {
            "name": "login",
            "id": "http://www.uliege.be/smart/xAPITerms/verbs/loggedin",
            "display": {
                "fr-FR": "est connecté"
            },
            "description": "L'utilisateur s'est connecté à l'application"
        },
        {
            "name": "logout",
            "id": "http://www.uliege.be/smart/xAPITerms/verbs/loggedout",
            "display": {
                "fr-FR": "est déconnecté"
            },
            "description": "L'utilisateur s'est déconnecté et/ou a cloturé sa session dans l'application"
        },
        {
            "name": "disconnect",
            "id": "http://www.uliege.be/smart/xAPITerms/verbs/disconnected",
            "display": {
                "fr-FR": "est désinscrit"
            },
            "description": "L'utilisateur à désactivé son affiliation au service."
        },
        {
            "name": "gave",
            "id": "http://activitystrea.ms/schema/1.0/give",
            "display": {
                "fr-FR": "à donné"
            },
            "description": "L'utilisateur à donné une information."
        },
        {
            "name": "updated",
            "id": "http://activitystrea.ms/schema/1.0/update",
            "display": {
                "fr-FR": "à mis à jour",
                "en-US": "updated"
            },
            "description": "The \"update\" verb indicates that the actor has modified the object. Use of the \"update\" verb is generally reserved to indicate modifications to existing objects or data such as changing user's status or mood, or an existing user's profile information."
        }
    ]
}