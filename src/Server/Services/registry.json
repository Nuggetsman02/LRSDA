        {
            "name": "Moods",
            "description": "Un objet dédié aux émotions",
            "type": "http://smart.uliege.be/ulla/moods",
            "ifi_root": "http://smart.uliege.be/ulla/moods",
            "extension": {
                "id": "http://smart.uliege.be/ulla/moods",
                "content": {
                    "mood_id": "the mood ID (from activity profile's list",
                    "intensity": "an int [0 < x <=100]"
                }
            }
        },
        {
            "name": "GenericObject",
            "description": "Un objet générique sans résultat. Normalement on ne devrait jamais avoir à gérer ce genre d'objet.",
            "type": "http://smart.uliege.be/ulla/undefined",
            "ifi_root": "http://smart.uliege.be/ulla/undefined",
            "extension": {
                "id": "http://smart.uliege.be/ulla/undefined/content",
                "content": {}
            }
        },
        {
            "name": "GenericObjectWithResult",
            "description": "Un objet générique AVEC résultat. Normalement on ne devrait jamais avoir à gérer ce genre d'objet.",
            "type": "http://smart.uliege.be/ulla/undefined-with-result",
            "ifi_root": "http://smart.uliege.be/ulla/undefined-with-result",
            "extension": {
                "id": "http://smart.uliege.be/ulla/undefined-with-result/content",
                "content": {}
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/undefined-with-result/result/content",
                    "content": {}
                }
            }
        },
        {
            "name": "Assessment",
            "description": "Un test, QCM ou QROL",
            "type": "http://adlnet.gov/expapi/activities/assessment",
            "ifi_root": "http://smart.uliege.be/ulla/assessment",
            "extension": {
                "id": "http://smart.uliege.be/ulla/assessment/info",
                "content": {
                    "questions": "int [number of questions in test]",
                    "tariff_type": "string [tariff name for QCM tests]",
                    "severity": 20,
                    "answers": [
                        1,
                        2,
                        3,
                        4
                    ],
                    "weights": [
                        1,
                        1,
                        1,
                        2,
                        1
                    ]
                }
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/assessment/result/info",
                    "content": {
                        "position": "int [student ranking in tests results]",
                        "questions": "int [number of questions in test]",
                        "answers": [
                            false,
                            true,
                            false,
                            true
                        ]
                    }
                }
            }
        },
        {
            "name": "AssessmentPart",
            "description": "Une partie de test QCM.",
            "type": "http://smart.uliege.be/ulla/assessment-part",
            "ifi_root": "http://smart.uliege.be/ulla/assessment/[root_id]/part",
            "extension": {
                "id": "http://smart.uliege.be/ulla/assessment/part/info",
                "content": {
                    "questions": [
                        1,
                        2,
                        3,
                        4,
                        5
                    ],
                    "answers": [
                        4,
                        3,
                        2,
                        1,
                        2
                    ]
                }
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/assessment/part/result/info",
                    "content": {
                        "position": "int [student ranking for this part of the test]",
                        "questions": [
                            1,
                            2,
                            3
                        ],
                        "answers": [
                            false,
                            true,
                            false
                        ]
                    }
                }
            }
        },
        {
            "name": "OpenAnswerQuestion",
            "description": "Une question à réponse ouverte longue",
            "type": "http://smart.uliege.be/ulla/assessment/open-answer-question",
            "ifi_root": "http://smart.uliege.be/ulla/assessment/[root_id]/question",
            "extension": {
                "id": "http://smart.uliege.be/ulla/assessment/open-answer-question/info",
                "content": {
                    "weight": {
                        "points": "int number of points in total points",
                        "percent": "float percentage of total points"
                    }
                }
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/assessment/open-answer-question/result/info",
                    "content": {
                        "position": "int [student ranking in tests results]"
                    }
                }
            }
        },
        {
            "name": "OpenAnswerQuestionCriteria",
            "description": "Un critère associé à une question à réponse ouverte longue",
            "type": "http://smart.uliege.be/ulla/assessment/open-answer-question-criteria",
            "ifi_root": "http://smart.uliege.be/ulla/assessment/[root_id]/question/[item_id]/criteria/",
            "extension": {
                "id": "http://smart.uliege.be/ulla/assessment/open-answer-question-criteria/info",
                "content": {
                    "weight": {
                        "points": "int number of points in total points",
                        "percent": "float percentage of total points"
                    },
                    "indicators": [
                        {
                            "title": "string [indicator title]",
                            "description": "string [indicator description]",
                            "value": "int [indicator value in points over 100]"
                        }
                    ]
                }
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/assessment/open-answer-question-criteria/result/info",
                    "content": {
                        "indicator": "int [selected indicator]",
                        "position": "int [student ranking in tests results]"
                    }
                }
            }
        },
        {
            "name": "Survey",
            "description": "Une enquête à caractère pédagogique orientée LA",
            "type": "http://id.tincanapi.com/activitytype/survey",
            "ifi_root": "http://smart.uliege.be/ulla/survey",
            "extension": {
                "id": "http://smart.uliege.be/ulla/survey",
                "content": {
                    "blocks": "text blocks coming from editorjs",
                    "version": "editorjs text-blocks version, should be 2.8.1"
                }
            }
        },
        {
            "name": "SurveyQuestion",
            "description": "Une question associée à une enquête à caractère pédagogique orientée LA",
            "type": "http://activitystrea.ms/schema/1.0/question",
            "ifi_root": "http://smart.uliege.be/ulla/survey/[root_id]/question",
            "extension": {
                "id": "http://smart.uliege.be/ulla/survey/question/info",
                "content": {
                    "type": "likert ",
                    "name": "string [the name of the question]",
                    "description": "string [question descption]",
                    "scale": [
                        {
                            "value": "int [value associated with this answer]",
                            "name": "string [the name of this propositon]"
                        }
                    ]
                }
            },
            "result": {
                "extension": {
                    "id": "http://smart.uliege.be/ulla/survey/question/result/info",
                    "content": {}
                }
            }
        },
        {
